# ==============================================
# Campus Buddy — Client Environment Variables
# Copy this file to .env and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ==============================================

# Base URL of the backend API
VITE_API_URL=http://localhost:3001/api

# Google OAuth Client ID (Web application), for the "Continue with Google"
# button — must be the SAME client ID as the server's GOOGLE_CLIENT_ID.
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional — Google Maps API key, for future event-location features
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
