# ==============================================
# Campus Buddy — AI Service Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
# ==============================================

# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Sentence-Transformers model used to embed resume chunks and questions
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking (word counts)
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Number of chunks retrieved per question
TOP_K=5

# Comma-separated list of origins allowed to call this service directly
# (the Express server is the normal caller, but this keeps local testing easy)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173

PORT=8000
