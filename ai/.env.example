# ==============================================
# Campus Buddy — AI Service Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
# ==============================================

# Server-side ONLY. Never expose these keys to the browser or commit them.
#
# LLM provider. Groq is used automatically when GROQ_API_KEY is set; set
# LLM_PROVIDER=gemini to use Gemini instead.
# LLM_PROVIDER=groq
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Gemini (only used when LLM_PROVIDER=gemini, or GROQ_API_KEY is unset)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Current GA Flash model. gemini-1.5-* and gemini-2.0-flash were retired by Google and now 404.
GEMINI_MODEL=gemini-3.6-flash

# Sentence-Transformers model used to embed resume chunks and questions
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking (word counts)
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Number of chunks retrieved per question
TOP_K=5

# Comma-separated list of browser origins allowed to call this service directly.
# Express calls it server-to-server (no CORS needed); this is only for local
# testing and any future direct-from-browser use. Include the deployed frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173

# Render provides PORT automatically; only needed for local dev.
PORT=8000

# Optional: absolute path to a persistent disk for uploaded PDFs + FAISS index
# (so a restart between upload and analyze doesn't lose the session).
# DATA_DIR=/var/data
